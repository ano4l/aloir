<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name | escape }}</title>{{ content_for_header }}{% style %}{{ settings.font_heading | font_face: font_display: 'swap' }}{{ settings.font_body | font_face: font_display: 'swap' }}:root{--ivory:{{ settings.color_background }};--beige:{{ settings.color_secondary }};--taupe:{{ settings.color_accent }};--ink:{{ settings.color_text }};--border:{{ settings.color_border }};--serif:{{ settings.font_heading.family }},{{ settings.font_heading.fallback_families }};--sans:{{ settings.font_body.family }},{{ settings.font_body.fallback_families }}}{% endstyle %}{{ 'theme.css' | asset_url | stylesheet_tag }}</head>
<body><main id="MainContent">{{ content_for_layout }}</main></body></html>
