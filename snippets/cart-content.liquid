{% if cart.item_count == 0 %}<div class="empty-state"><h2>Your bag is waiting.</h2><p>Find something you will reach for again and again.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" class="cart-form"><div class="cart-items">{% for item in cart.items %}<article class="cart-item"><a href="{{ item.url }}">{% render 'responsive-image', image: item.image, sizes: '100px' %}</a><div><h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% if property.last != blank and first_char != '_' %}<p>{{ property.first }}: {{ property.last }}</p>{% endif %}{% endfor %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name }}</p>{% endif %}<p>{{ item.final_line_price | money }}{% if item.original_line_price > item.final_line_price %} <s>{{ item.original_line_price | money }}</s>{% endif %}</p>{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>{% endfor %}<div class="cart-quantity"><label class="visually-hidden" for="CartQty-{{ context }}-{{ forloop.index }}">Quantity for {{ item.product.title | escape }}</label><button type="button" data-cart-step="-1" data-key="{{ item.key }}" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button><input id="CartQty-{{ context }}-{{ forloop.index }}" name="updates[]" value="{{ item.quantity }}" min="0" type="number" data-cart-quantity data-key="{{ item.key }}"><button type="button" data-cart-step="1" data-key="{{ item.key }}" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button><a href="{{ item.url_to_remove }}" data-cart-remove data-key="{{ item.key }}">Remove</a></div></div></article>{% endfor %}</div><div class="cart-summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title }} <span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}<p class="subtotal">Subtotal <span>{{ cart.total_price | money }}</span></p><p class="small-text">Taxes, discounts, and shipping calculated at checkout.</p><p class="form-message" role="alert" data-cart-error></p><noscript><button class="button" name="update" type="submit">Update bag</button></noscript><button class="button" name="checkout" type="submit">Checkout</button><a class="text-link" href="{{ routes.cart_url }}">View bag</a></div></form>{% endif %}
