<dialog id="CartDrawer" class="side-dialog" aria-labelledby="CartDrawerTitle"><div class="drawer-heading"><h2 id="CartDrawerTitle">Your bag <span data-cart-count>{{ cart.item_count }}</span></h2><button type="button" data-close-dialog aria-label="Close bag">{% render 'icon', name: 'close' %}</button></div><div data-cart-drawer-content>{% render 'cart-content', context: 'drawer' %}</div></dialog>
