{% liquid
 assign current_sort = results.sort_by | default: results.default_sort_by
 if search_context
  assign encoded_terms = results.terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&type=product&options%5Bprefix%5D=last&sort_by=' | append: current_sort
 else
  assign clear_url = results.url | append: '?sort_by=' | append: current_sort
 endif
%}
{% capture chips %}{% for filter in results.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove | escape }}" aria-label="Remove {{ filter.label | escape }}: {{ value.label | escape }}">{{ filter.label }}: {{ value.label }} <span aria-hidden="true">×</span></a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}<a href="{{ filter.url_to_remove | escape }}" aria-label="Remove price filter">Price: {% if filter.min_value.value != nil %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %}–{% if filter.max_value.value != nil %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %} <span aria-hidden="true">×</span></a>{% endif %}{% endif %}{% endfor %}{% endcapture %}
{% if chips != blank %}<nav class="active-filters" aria-label="Applied filters"><a class="clear-filters" href="{{ clear_url | escape }}">Clear all filters</a>{{ chips }}</nav>{% endif %}