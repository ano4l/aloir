{% if product.metafields.custom.delivery_summary != blank or product.metafields.custom.returns_summary != blank or shop.shipping_policy != blank or shop.refund_policy != blank %}<aside class="product-fulfilment" data-fulfilment-summary aria-label="Delivery and returns">{% if product.metafields.custom.delivery_summary != blank %}<div><h2>Delivery</h2><div class="rte">{{ product.metafields.custom.delivery_summary | metafield_tag }}</div></div>{% endif %}{% if product.metafields.custom.returns_summary != blank %}<div><h2>Returns</h2><div class="rte">{{ product.metafields.custom.returns_summary | metafield_tag }}</div></div>{% endif %}<div class="policy-links">{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping policy</a>{% endif %}{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">Returns policy</a>{% endif %}</div></aside>{% endif %}
