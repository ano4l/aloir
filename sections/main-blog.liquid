<section class="section"><h1>{{ blog.title }}</h1>{% paginate blog.articles by 12 %}<div class="category-grid">{% for article in blog.articles %}<article><a href="{{ article.url }}">{% render 'responsive-image', image: article.image, alt: article.title %}<h2>{{ article.title }}</h2></a><p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p></article>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}
{
  "name": "Journal",
  "settings": []
}
{% endschema %}
