<section class="section text-page"><p class="wordmark" style="text-align:center">{{ settings.brand_name }}</p><h1>{{ section.settings.heading }}</h1>{% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% endif %}{% form 'storefront_password' %}<label for="StorePassword">Store password</label><input id="StorePassword" type="password" name="password" required autocomplete="current-password">{{ form.errors | default_errors }}<button class="button" type="submit">Enter store</button>{% endform %}</section>
{% schema %}
{"name":"Password page","settings":[{"type":"text","id":"heading","label":"Heading","default":"A new perspective, soon."}]}
{% endschema %}
