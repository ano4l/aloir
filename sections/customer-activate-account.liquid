<section class="section text-page"><h1>Activate your account</h1>{% form 'activate_customer_password' %}{{ form.errors | default_errors }}<label for="ActivatePassword">Password</label><input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required><label for="ActivateConfirm">Confirm password</label><input id="ActivateConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required><button class="button" type="submit">Activate account</button><button type="submit" name="decline">Decline invitation</button>{% endform %}</section>
{% schema %}{"name":"Activate account","settings":[]}{% endschema %}
