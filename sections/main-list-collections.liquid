<section class="section collection-directory" aria-labelledby="DirectoryHeading-{{ section.id }}"><div class="discovery-page-heading"><p class="eyebrow">The wardrobe, at a glance</p><h1 id="DirectoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1><p>{{ section.settings.introduction | escape }}</p></div>
{% paginate collections by 48 %}<div class="directory-grid">{% assign public_index = 0 %}{% for category in collections %}{% assign normalized_title = category.title | downcase %}{% unless category.handle == 'frontpage' or category.handle == 'home-page' or normalized_title == 'home page' %}{% assign public_index = public_index | plus: 1 %}{% render 'collection-directory-card', category: category, index: public_index %}{% endunless %}{% endfor %}</div>{% if public_index == 0 %}<div class="empty-state"><h2>The collection is taking shape.</h2><p>New categories will appear here as they arrive.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Browse all pieces {% render 'icon', name: 'arrow' %}</a></div>{% endif %}{% render 'pagination', paginate: paginate %}{% endpaginate %}
<div class="directory-bottom"><p>Prefer to discover as you go?</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Shop every piece {% render 'icon', name: 'arrow' %}</a></div></section>
{% schema %}
{"name":"All categories","settings":[{"type":"text","id":"heading","label":"Heading","default":"Every side of your wardrobe."},{"type":"text","id":"introduction","label":"Introduction","default":"From your first layer to your finishing touch. Find a collection, then make it your own."}]}
{% endschema %}
