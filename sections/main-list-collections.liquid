<section class="section collection-directory" aria-labelledby="DirectoryHeading-{{ section.id }}">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>Collections</span></nav>
  <div class="discovery-page-heading directory-heading"><div><p class="eyebrow">The wardrobe, thoughtfully arranged</p><h1 id="DirectoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1></div><div><p>{{ section.settings.introduction | escape }}</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Shop every piece {% render 'icon', name: 'arrow' %}</a></div></div>
  {% paginate collections by 48 %}
    {% assign active_count = 0 %}{% assign upcoming_count = 0 %}
    {% for category in collections %}{% assign normalized_title = category.title | downcase %}{% unless category.handle == 'frontpage' or category.handle == 'home-page' or normalized_title == 'home page' %}{% if category.all_products_count > 0 %}{% assign active_count = active_count | plus: 1 %}{% else %}{% assign upcoming_count = upcoming_count | plus: 1 %}{% endif %}{% endunless %}{% endfor %}
    {% if active_count > 0 %}
      <div class="directory-section-heading"><h2>Find your starting point.</h2><span>{{ active_count }} {% if active_count == 1 %}collection{% else %}collections{% endif %} to explore</span></div>
      <div class="directory-grid">
        {% assign public_index = 0 %}{% assign preferred_handles = 'tops,dresses,denim,sweaters-knitwear,features' | split: ',' %}
        {% for preferred_handle in preferred_handles %}{% for category in collections %}{% if category.handle == preferred_handle and category.all_products_count > 0 %}{% assign public_index = public_index | plus: 1 %}{% render 'collection-directory-card', category: category, index: public_index %}{% endif %}{% endfor %}{% endfor %}
        {% for category in collections %}{% assign normalized_title = category.title | downcase %}{% unless preferred_handles contains category.handle or category.handle == 'frontpage' or category.handle == 'home-page' or normalized_title == 'home page' %}{% if category.all_products_count > 0 %}{% assign public_index = public_index | plus: 1 %}{% render 'collection-directory-card', category: category, index: public_index %}{% endif %}{% endunless %}{% endfor %}
      </div>
    {% else %}<div class="empty-state"><h2>The collection is taking shape.</h2><p>New pieces will appear here as they arrive.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Browse all pieces {% render 'icon', name: 'arrow' %}</a></div>{% endif %}
    {% if upcoming_count > 0 %}<aside class="upcoming-collections" aria-labelledby="UpcomingHeading-{{ section.id }}"><div><p class="eyebrow">On the horizon</p><h2 id="UpcomingHeading-{{ section.id }}">A little room for what’s next.</h2><p>These collections are still taking shape. Explore the available edits above.</p></div><div class="upcoming-collection-links">{% for category in collections %}{% assign normalized_title = category.title | downcase %}{% unless category.handle == 'frontpage' or category.handle == 'home-page' or normalized_title == 'home page' %}{% if category.all_products_count == 0 %}<a href="{{ category.url }}"><span>{{ category.title | escape }}</span><span>Coming soon {% render 'icon', name: 'arrow' %}</span></a>{% endif %}{% endunless %}{% endfor %}</div></aside>{% endif %}
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
  <div class="directory-bottom"><p>A different way to find your next favourite.</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Explore the complete collection {% render 'icon', name: 'arrow' %}</a></div>
</section>
{% schema %}
{"name":"All categories","settings":[{"type":"text","id":"heading","label":"Heading","default":"Every side of your wardrobe."},{"type":"text","id":"introduction","label":"Introduction","default":"Start with a silhouette, a texture, a feeling. Discover the collections that bring your wardrobe together."}]}
{% endschema %}
