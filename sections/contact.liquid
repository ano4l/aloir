<section class="section text-page"><h1>{{ page.title }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact' %}{% if form.posted_successfully? %}<p role="status">Thank you. Your message has been sent.</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"><label for="ContactEmail">Email</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email }}"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea><button class="button">Send message</button>{% endform %}</section>
{% schema %}
{
  "name": "Contact form",
  "settings": []
}
{% endschema %}
