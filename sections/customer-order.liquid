<section class="section text-page"><h1>{{ order.name }}</h1><p>{{ order.created_at | time_tag: format: 'date' }}</p>{% if order.cancelled %}<p>Cancelled: {{ order.cancel_reason_label }}</p>{% endif %}{% for line_item in order.line_items %}<article class="cart-item"><div>{% render 'responsive-image', image: line_item.image, sizes: '90px' %}</div><div><h3>{{ line_item.title }}</h3><p>Quantity {{ line_item.quantity }} · {{ line_item.final_line_price | money }}</p>{% if line_item.fulfillment %}<p>{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}{% if line_item.fulfillment.tracking_url %} <a href="{{ line_item.fulfillment.tracking_url }}">Track delivery</a>{% endif %}</p>{% endif %}</div></article>{% endfor %}<p>Total {{ order.total_price | money }}</p><h2>Shipping address</h2>{{ order.shipping_address | format_address }}<h2>Billing address</h2>{{ order.billing_address | format_address }}<a class="text-link" href="{{ routes.account_url }}">Back to account</a></section>
{% schema %}{"name":"Customer order","settings":[]}{% endschema %}
