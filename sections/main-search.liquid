<section class="section main-search"><header class="page-heading"><p class="eyebrow">Find your next piece</p><h1>Search the collection</h1><form action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="PageSearch-{{ section.id }}">Search</label><div class="input-row"><input id="PageSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Try a garment, colour or detail" required><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"><button class="button">Search</button></div></form></header>
{% if search.performed %}<button type="button" class="button mobile-filter-button" data-open-filters hidden>Filter &amp; sort {% render 'icon', name: 'plus' %}</button><div data-filter-controls>{% render 'filters', results: search, search_context: true, section_id: section.id %}</div>{% render 'active-filters', results: search, search_context: true %}
{% paginate search.results by 20 %}<p class="result-count">{{ search.results_count }} results for “{{ search.terms | escape }}”</p><h2 class="visually-hidden">Search results</h2><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<div class="empty-state"><h2>No pieces found</h2><p>Remove filters to broaden this search, or try a different garment or detail above.</p><a class="text-link" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&amp;type=product&amp;options%5Bprefix%5D=last&amp;sort_by={{ search.sort_by | default: search.default_sort_by | url_encode }}">Search without filters</a><a class="text-link" href="{{ routes.all_products_collection_url }}">Explore the collection</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>
{% schema %}

{

  "name": "Search",

  "settings": []

}

{% endschema %}

