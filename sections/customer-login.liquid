<section class="section text-page"><h1>Welcome back</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required><label for="CustomerPassword">Password</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required><button class="button" type="submit">Sign in</button><p><a class="text-link" href="{{ routes.account_register_url }}">Create an account</a></p>{% endform %}<details><summary>Forgot your password?</summary>{% form 'recover_customer_password' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">Check your email for password reset instructions.</p>{% endif %}<label for="RecoverEmail">Email</label><input id="RecoverEmail" type="email" name="email" autocomplete="email" required><button class="button" type="submit">Send reset email</button>{% endform %}</details></section>
{% schema %}{"name":"Customer login","settings":[]}{% endschema %}
