<section class="section image-with-text {% if section.settings.image_right %}image-right{% endif %}"><div class="editorial-image">{% render 'responsive-image', image: section.settings.image %}</div><div class="editorial-copy"><h2>{{ section.settings.heading }}</h2>{{ section.settings.text }}{% if section.settings.link %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Considered by design"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Considered silhouettes, timeless details, and the quiet confidence of dressing well.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Discover the edit"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "Image on right",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
