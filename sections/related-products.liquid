<div data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=5&intent=related">{% if recommendations.performed and recommendations.products_count > 0 %}<section class="section"><h2 class="section-title">{{ section.settings.heading }}</h2><div class="product-grid">{% for product in recommendations.products %}{% render 'product-card', product: product %}{% endfor %}</div></section>{% endif %}</div>
{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
