<section class="section text-page"><h1>My account</h1><p>{{ customer.name }} · {{ customer.email }}</p><a class="text-link" href="{{ routes.account_logout_url }}">Sign out</a><h2 style="margin-top:35px">Orders</h2>{% paginate customer.orders by 20 %}{% for order in customer.orders %}<article><h3><a href="{{ order.customer_url }}">{{ order.name }}</a></h3><p>{{ order.created_at | time_tag: format: 'date' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }} · {{ order.total_price | money }}</p></article>{% else %}<p>You haven't placed an order yet.</p>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}<h2>Address book</h2>{{ customer.default_address | format_address }}<a class="text-link" href="{{ routes.account_addresses_url }}">Manage addresses</a></section>
{% schema %}{"name":"Customer account","settings":[]}{% endschema %}
