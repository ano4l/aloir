<section class="section collection-section collection-discovery" id="Collection-{{ section.id }}" aria-labelledby="FeaturedHeading-{{ section.id }}">
  <div class="collection-heading"><div><p class="eyebrow">The Aloir Apparel selection</p><h2 id="FeaturedHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p class="collection-introduction">{{ section.settings.introduction | escape }}</p></div><a class="text-link discovery-all" href="{{ routes.collections_url }}">View all categories {% render 'icon', name: 'arrow' %}</a></div>
  {% render 'collection-switcher', section: section, mode: 'featured' %}
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find your next favourite."},{"type":"text","id":"introduction","label":"Introduction","default":"A considered selection. A wardrobe that feels like you."},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"collection","id":"tops_collection","label":"Tops collection"},{"type":"collection","id":"dresses_collection","label":"Dresses collection"},{"type":"collection","id":"denim_collection","label":"Denim collection"},{"type":"collection","id":"knitwear_collection","label":"Knitwear collection"},{"type":"range","id":"limit","label":"Pieces per tab","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
