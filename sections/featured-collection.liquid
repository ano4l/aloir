<section class="section collection-section {% if section.settings.carousel %}collection-carousel{% endif %}" id="Collection-{{ section.id }}"><div class="collection-heading"><div><p class="eyebrow">Selected with intention</p><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.introduction != blank %}<p class="collection-introduction">{{ section.settings.introduction | escape }}</p>{% endif %}</div><nav class="collection-tabs" aria-label="Collection categories"><a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">All</a>{% for block in section.blocks %}{% if block.settings.collection != blank %}<a href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</a>{% endif %}{% endfor %}</nav></div>

{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}{% assign featured_columns = section.settings.collection.products_count | at_most: section.settings.limit | at_most: 5 %}<div class="product-grid featured-product-grid" style="--featured-columns: {{ featured_columns }}">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div><div class="collection-end"><a class="text-link" href="{{ section.settings.collection.url }}">View all pieces {% render 'icon', name: 'arrow' %}</a></div>{% else %}<div class="empty-collection"><h3>A collection, considered.</h3><p>Our next edit is taking shape. Discover new pieces here as they arrive.</p>{% if request.design_mode %}<p class="editor-note">Choose a collection in this section's settings. Published Shopify products will appear automatically.</p>{% endif %}</div>{% endif %}</section>

{% schema %}

{

  "name": "Featured collection",

  "settings": [

    {"type":"text","id":"introduction","label":"Introduction","default":"The pieces you return to. The details that make them yours."},

    {

      "type": "text",

      "id": "heading",

      "label": "Heading",

      "default": "The collection"

    },

    {

      "type": "collection",

      "id": "collection",

      "label": "Collection"

    },

    {

      "type": "range",

      "id": "limit",

      "label": "Product count",

      "min": 2,

      "max": 20,

      "step": 1,

      "default": 5

    },

    {

      "type": "checkbox",

      "id": "carousel",

      "label": "Horizontal carousel",

      "default": false

    }

  ],

  "blocks": [

    {

      "type": "collection",

      "name": "Collection link",

      "settings": [

        {

          "type": "collection",

          "id": "collection",

          "label": "Collection"

        },

        {

          "type": "text",

          "id": "label",

          "label": "Label"

        }

      ]

    }

  ],

  "presets": [

    {

      "name": "Featured collection"

    }

  ]

}

{% endschema %}

