<div class="quick-shop-content"><a class="quick-shop-image" href="{{ product.url }}">{% render 'responsive-image', image: product.featured_image, sizes: '(min-width: 750px) 320px, 40vw', loading: 'eager' %}</a><div data-product-section><h2>{{ product.title }}</h2>{% assign selected_variant = product.selected_or_first_available_variant %}<p class="product-price" data-variant-price>{{ selected_variant.price | money }}{% if selected_variant.compare_at_price > selected_variant.price %} <s>{{ selected_variant.compare_at_price | money }}</s>{% endif %}</p><p class="variant-saving" data-variant-saving>{% if selected_variant.compare_at_price > selected_variant.price %}Save {{ selected_variant.compare_at_price | minus: selected_variant.price | money }}{% endif %}</p>{% assign form_id = 'QuickShopForm-' | append: product.id %}{% form 'product', product, id: form_id, class: 'product-form', data-product-form: '' %}{% unless product.has_only_default_variant %}<div data-option-groups hidden>{% for option in product.options_with_values %}<label for="QuickOption-{{ product.id }}-{{ forloop.index }}">{{ option.name }}</label><select id="QuickOption-{{ product.id }}-{{ forloop.index }}" data-product-option>{% for value in option.values %}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>{% endfor %}</select>{% endfor %}</div>{% endunless %}<div data-native-variant><label for="QuickVariant-{{ product.id }}">Options</label><select id="QuickVariant-{{ product.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == selected_variant.id %}selected{% endif %}>{{ variant.title }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select></div><input type="hidden" name="quantity" value="1"><p class="selection-summary" data-selection-summary>{{ selected_variant.title }}{% unless selected_variant.available %} · Sold out{% endunless %}</p><button class="button add-to-bag" type="submit" data-add-button {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}Add to bag{% else %}Sold out{% endif %}</button><p class="form-message" role="status"></p>{% endform %}<a class="text-link" href="{{ product.url }}">View full details {% render 'icon', name: 'arrow' %}</a><script type="application/json" data-variants>{{ product.variants | json }}</script></div></div>
{% schema %}{"name":"Quick shop","settings":[]}{% endschema %}
