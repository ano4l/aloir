<section class="featured-edit"><div>{% render 'responsive-image', image: section.settings.image, fallback: 'hero-3.webp' %}</div><div class="featured-edit-copy"><h2>{{ section.settings.heading }}</h2><a class="button button-light" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.label }}</a></div></section>
{% schema %}
{
  "name": "Featured edit",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "An exercise in simplicity"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Discover the edit"
    }
  ],
  "presets": [
    {
      "name": "Featured edit"
    }
  ]
}
{% endschema %}
