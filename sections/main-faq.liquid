<section class="section faq-page" aria-labelledby="FaqHeading-{{ section.id }}"><div class="faq-intro"><p class="eyebrow">A little clarity</p><h1 id="FaqHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1><p>{{ section.settings.introduction | escape }}</p><nav class="faq-jump" aria-label="Frequently asked question topics"><a href="#FaqShopping-{{ section.id }}">Shopping & fit</a><a href="#FaqDelivery-{{ section.id }}">Delivery & returns</a><a href="#FaqOrders-{{ section.id }}">Your order</a></nav><a class="text-link" href="{{ routes.collections_url }}">Back to the collections {% render 'icon', name: 'arrow' %}</a></div><div class="faq-content">
<div class="faq-group" id="FaqShopping-{{ section.id }}"><p class="eyebrow">01 / Shopping & fit</p><h2>Find your fit.</h2><details><summary>{{ section.settings.question_1 | escape }} <span aria-hidden="true">+</span></summary><div class="rte">{{ section.settings.answer_1 }}</div></details><details><summary>{{ section.settings.question_2 | escape }} <span aria-hidden="true">+</span></summary><div class="rte">{{ section.settings.answer_2 }}</div></details></div>
<div class="faq-group" id="FaqDelivery-{{ section.id }}"><p class="eyebrow">02 / Delivery & returns</p><h2>The details that matter.</h2><details><summary>{{ section.settings.question_3 | escape }} <span aria-hidden="true">+</span></summary><div class="rte">{{ section.settings.answer_3 }}</div></details><details><summary>{{ section.settings.question_4 | escape }} <span aria-hidden="true">+</span></summary><div class="rte">{{ section.settings.answer_4 }}</div></details></div>
<div class="faq-group" id="FaqOrders-{{ section.id }}"><p class="eyebrow">03 / Your order</p><h2>From bag to doorstep.</h2><details><summary>{{ section.settings.question_5 | escape }} <span aria-hidden="true">+</span></summary><div class="rte">{{ section.settings.answer_5 }}</div></details><details><summary>{{ section.settings.question_6 | escape }} <span aria-hidden="true">+</span></summary><div class="rte">{{ section.settings.answer_6 }}</div></details></div>
{% if section.blocks.size > 0 %}<div class="faq-group"><p class="eyebrow">More to know</p><h2>Your questions, answered.</h2>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }} <span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}</div>{% endif %}
<div class="policy-links">{% if shop.shipping_policy.url %}<a href="{{ shop.shipping_policy.url }}">Shipping policy</a>{% endif %}{% if shop.refund_policy.url %}<a href="{{ shop.refund_policy.url }}">Return policy</a>{% endif %}</div><div class="faq-contact"><h2>A little more help?</h2><p>{{ section.settings.contact_text | escape }}</p>{% if section.settings.contact_link != blank %}<a class="text-link" href="{{ section.settings.contact_link }}">Contact customer care {% render 'icon', name: 'arrow' %}</a>{% elsif shop.email != blank %}<a class="text-link" href="mailto:{{ shop.email }}">Contact customer care {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
</div></section>
{% schema %}
{
  "name": "FAQ & customer care",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know."
    },
    {
      "type": "text",
      "id": "introduction",
      "label": "Introduction",
      "default": "Thoughtful answers to help you shop with confidence."
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact introduction",
      "default": "We are here to help you find your way."
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Customer care page"
    },
    {
      "type": "text",
      "label": "Question 6",
      "id": "question_6",
      "default": "Can I change an order after placing it?"
    },
    {
      "type": "richtext",
      "label": "Answer 6",
      "id": "answer_6",
      "default": "<p>Contact us as soon as possible with your order number and requested change. Changes depend on the order's fulfillment status and cannot be guaranteed once processing has begun.</p>"
    },
    {
      "type": "text",
      "label": "Question 5",
      "id": "question_5",
      "default": "Can I review my order before paying?"
    },
    {
      "type": "richtext",
      "label": "Answer 5",
      "id": "answer_5",
      "default": "<p>Yes. Your bag lets you review sizes, quantities and the item subtotal. Continue to checkout to review your address, delivery options, any applicable taxes and your final total before submitting payment.</p>"
    },
    {
      "type": "text",
      "label": "Question 4",
      "id": "question_4",
      "default": "How do returns work?"
    },
    {
      "type": "richtext",
      "label": "Answer 4",
      "id": "answer_4",
      "default": "<p>Review the current return policy before ordering, including eligibility, exclusions and any return shipping costs. If you need help with an item, contact us with your order number and the details of your request.</p>"
    },
    {
      "type": "text",
      "label": "Question 3",
      "id": "question_3",
      "default": "Where do you deliver, and what will shipping cost?"
    },
    {
      "type": "richtext",
      "label": "Answer 3",
      "id": "answer_3",
      "default": "<p>Delivery availability, options and shipping charges depend on your destination and the items in your bag. Enter your address at checkout to see the available options before paying.</p>"
    },
    {
      "type": "text",
      "label": "Question 2",
      "id": "question_2",
      "default": "Can I save a piece for later?"
    },
    {
      "type": "richtext",
      "label": "Answer 2",
      "id": "answer_2",
      "default": "<p>Use the heart on a product to add it to your saved pieces on this browser. Saving a piece does not reserve it or hold its price. You can revisit your selection using the heart in the navigation.</p>"
    },
    {
      "type": "text",
      "label": "Question 1",
      "id": "question_1",
      "default": "How do I choose my size?"
    },
    {
      "type": "richtext",
      "label": "Answer 1",
      "id": "answer_1",
      "default": "<p>Start with the size and fit information on the individual product page. Where product measurements are available, compare them with a similar piece you own. Measurements can vary between styles, so check each piece before ordering.</p>"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Additional question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add your store's answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ & customer care"
    }
  ]
}
{% endschema %}
