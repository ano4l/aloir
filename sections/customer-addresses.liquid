<section class="section text-page"><h1>Address book</h1><a class="text-link" href="{{ routes.account_url }}">Back to account</a><details style="margin-top:30px"><summary>Add a new address</summary>{% form 'customer_address', customer.new_address %}{{ form.errors | default_errors }}{% render 'address-fields', form: form, address_id: 'New' %}<button class="button" type="submit">Add address</button>{% endform %}</details>{% paginate customer.addresses by 10 %}{% for address in customer.addresses %}<article style="margin-top:35px">{% if address == customer.default_address %}<p>Default address</p>{% endif %}{{ address | format_address }}<details><summary>Edit address</summary>{% form 'customer_address', address %}{{ form.errors | default_errors }}{% render 'address-fields', form: form, address_id: address.id %}<button class="button" type="submit">Save address</button>{% endform %}</details><form action="{{ routes.account_addresses_url }}/{{ address.id }}" method="post" data-delete-address><input type="hidden" name="_method" value="delete"><button type="submit">Delete address</button></form></article>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}{"name":"Customer addresses","settings":[]}{% endschema %}
