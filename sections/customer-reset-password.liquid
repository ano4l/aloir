<section class="section text-page"><h1>Reset your password</h1>{% form 'reset_customer_password' %}{{ form.errors | default_errors }}<label for="ResetPassword">New password</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required><label for="ResetConfirm">Confirm new password</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required><button class="button" type="submit">Reset password</button>{% endform %}</section>
{% schema %}{"name":"Reset password","settings":[]}{% endschema %}
