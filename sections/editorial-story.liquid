<section class="editorial-story"><div class="story-portrait">{% render 'responsive-image', image: section.settings.image, fallback: 'story.webp', alt: 'Illustrative fashion editorial in cream tailoring' %}</div><div class="story-content"><p class="story-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.wordmark | escape }}</h2><div class="story-text">{{ section.settings.text }}{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></div><div class="story-detail">{% render 'responsive-image', image: section.settings.detail_image, fallback: 'detail.webp', alt: 'Illustrative editorial study of tailoring details' %}</div><span class="story-rule" aria-hidden="true"></span></section>{% if section.blocks.size > 0 %}<section class="section styling-principles" aria-label="Eloir styling notes">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="principle-number">0{{ forloop.index }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</section>{% endif %}
{% schema %}
{
  "name": "Editorial story",
  "max_blocks":3,
  "blocks":[{"type":"principle","name":"Styling principle","settings":[{"type":"text","id":"heading","label":"Heading","default":"Begin with a silhouette"},{"type":"text","id":"text","label":"Text","default":"Let one considered shape set the tone. Keep the rest beautifully simple."}]}],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Tailoring detail image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Introductory line",
      "default": "The art of contemporary elegance"
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Large wordmark",
      "default": "Eloir"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Considered silhouettes, timeless details, and the quiet confidence of dressing well.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Our story"
    }
  ],
  "presets": [
    {
      "name": "Editorial story"
    }
  ]
}
{% endschema %}
