{% assign storefront_root = routes.root_url | append: '/' | replace: '//', '/' %}
<section class="section main-collection"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>{{ collection.title }}</span></nav><header class="page-heading"><h1>{{ collection.title }}</h1><div class="rte">{{ collection.description }}</div></header>{% if section.settings.show_image and collection.image %}<div class="collection-hero">{% render 'responsive-image', image: collection.image, sizes: '100vw' %}</div>{% endif %}{% if collection.all_products_count == 0 %}<div class="empty-state collection-awaiting"><p class="eyebrow">Room for what comes next</p><h2>This collection is taking shape.</h2><p>New pieces will appear here as they arrive. In the meantime, discover the collections available now.</p><div class="empty-collection-links"><a class="button" href="{{ routes.collections_url }}">View all categories {% render 'icon', name: 'arrow' %}</a><a class="text-link" href="{{ storefront_root }}pages/explore">Explore the wardrobe {% render 'icon', name: 'arrow' %}</a></div></div>{% else %}<button type="button" class="button mobile-filter-button" data-open-filters hidden>Filter &amp; sort {% render 'icon', name: 'plus' %}</button><div data-filter-controls>{% render 'filters', results: collection, section_id: section.id %}</div>{% render 'active-filters', results: collection %}{% paginate collection.products by section.settings.products_per_page %}<p class="result-count">{{ collection.products_count }} pieces</p><h2 class="visually-hidden">Collection products</h2><div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="empty-state"><h2>No pieces found</h2><p>Try adjusting your filters.</p><a class="text-link" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by | url_encode }}">Clear filters</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>

{% schema %}

{

  "name": "Collection",

  "settings": [

    {

      "type": "checkbox",

      "id": "show_image",

      "label": "Show collection image",

      "default": false

    },

    {

      "type": "range",

      "id": "products_per_page",

      "label": "Products per page",

      "min": 10,

      "max": 50,

      "step": 5,

      "default": 20

    }

  ]

}

{% endschema %}
