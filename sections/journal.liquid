<section class="section journal-section"><div class="journal-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.blog != blank %}<a class="text-link" href="{{ section.settings.blog.url }}">Read the journal {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>{% if section.settings.blog.articles_count > 0 %}<div class="journal-grid">{% for article in section.settings.blog.articles limit: 3 %}<article><a class="journal-image" href="{{ article.url }}">{% render 'responsive-image', image: article.image, sizes: '(min-width: 750px) 33vw, 100vw', alt: article.title %}</a><p class="small-text">{{ article.published_at | date: '%B %d, %Y' }}</p><h3><a href="{{ article.url }}">{{ article.title }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p></article>{% endfor %}</div>{% else %}<div class="journal-empty"><p>{{ section.settings.empty_text | escape }}</p>{% if request.design_mode %}<p class="editor-note">Choose a blog with published articles. This section never displays sample articles.</p>{% endif %}</div>{% endif %}</section>
{% schema %}
{"name":"Journal","settings":[{"type":"text","id":"heading","label":"Heading","default":"Notes on dressing"},{"type":"blog","id":"blog","label":"Blog"},{"type":"text","id":"empty_text","label":"Empty journal text","default":"Ideas for the pieces you love, and the way you wear them. Our journal is taking shape."}],"presets":[{"name":"Journal"}]}
{% endschema %}
