{% liquid
 assign campaign_collection = section.settings.collection
 assign campaign_url = campaign_collection.url | default: routes.all_products_collection_url
 assign offer_enabled = section.settings.enable_offer
 if offer_enabled and section.settings.discount_code != blank
   assign encoded_code = section.settings.discount_code | url_encode
   assign encoded_redirect = campaign_url | url_encode
   assign discount_root = routes.root_url
   if discount_root == '/'
     assign discount_root = ''
   endif
   assign campaign_url = discount_root | append: '/discount/' | append: encoded_code | append: '?redirect=' | append: encoded_redirect
 endif
%}
<section class="section seasonal-edit" aria-labelledby="SeasonalHeading-{{ section.id }}"><div class="seasonal-composition"><div class="seasonal-image">{% render 'responsive-image', image: section.settings.image, fallback: 'hero-3.webp', alt: 'Eloir illustrative seasonal fashion editorial', sizes: '(min-width: 750px) 50vw, 100vw' %}</div><div class="seasonal-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="SeasonalHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if offer_enabled and section.settings.offer_text != blank %}<div class="seasonal-offer"><p>{{ section.settings.offer_text | escape }}</p>{% if section.settings.discount_code != blank %}<p class="offer-code">Use code <strong>{{ section.settings.discount_code | escape }}</strong></p>{% endif %}{% if section.settings.terms != blank %}<div class="small-text">{{ section.settings.terms }}</div>{% endif %}</div>{% endif %}<a class="button" href="{{ campaign_url }}">{{ section.settings.label | escape }}</a><p class="seasonal-note">{{ section.settings.note | escape }}</p></div></div>{% if campaign_collection != blank and campaign_collection.products_count > 0 and section.settings.show_products %}<div class="seasonal-products-heading"><h3>{{ section.settings.products_heading | escape }}</h3><a class="text-link" href="{{ campaign_collection.url }}">View the edit {% render 'icon', name: 'arrow' %}</a></div><div class="product-grid seasonal-product-grid">{% for product in campaign_collection.products limit: 3 %}{% render 'product-card', product: product %}{% endfor %}</div>{% elsif request.design_mode %}<p class="editor-note">Select a collection to show seasonal pieces. Offer messaging stays hidden until you enable it after creating the matching discount in Shopify.</p>{% endif %}</section>
{% schema %}
{"name":"Seasonal edit & offers","settings":[{"type":"image_picker","id":"image","label":"Campaign image"},{"type":"collection","id":"collection","label":"Seasonal collection"},{"type":"text","id":"eyebrow","label":"Introductory line","default":"The seasonal edit"},{"type":"text","id":"heading","label":"Heading","default":"A change of perspective."},{"type":"richtext","id":"text","label":"Editorial text","default":"<p>New proportions. Deeper tones. Familiar favourites, seen differently. Find the pieces that make this season your own.</p>"},{"type":"text","id":"label","label":"Button label","default":"Explore the seasonal edit"},{"type":"text","id":"note","label":"Optional editorial note","default":"A season, styled your way."},{"type":"checkbox","id":"show_products","label":"Show selected collection products","default":true},{"type":"text","id":"products_heading","label":"Product row heading","default":"In this edit"},{"type":"header","content":"Merchant-configured seasonal offer"},{"type":"paragraph","content":"Create and test the discount in Shopify first. The theme cannot verify or create discounts. Enable only while your campaign is valid, and state exclusions and dates in the terms."},{"type":"checkbox","id":"enable_offer","label":"Enable configured offer messaging","default":false},{"type":"text","id":"offer_text","label":"Actual offer description"},{"type":"text","id":"discount_code","label":"Existing Shopify discount code"},{"type":"richtext","id":"terms","label":"Offer terms, dates and exclusions"}],"presets":[{"name":"Seasonal edit & offers"}]}
{% endschema %}
