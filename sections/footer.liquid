{% assign storefront_root = routes.root_url | append: '/' | replace: '//', '/' %}
<footer class="site-footer section"><div class="footer-top"><div class="footer-identity"><a class="wordmark" href="{{ routes.root_url }}">{% render 'brand-wordmark' %}</a><p>A considered wardrobe.<br>A point of view, entirely your own.</p></div><div class="footer-columns">{% for block in section.blocks %}
{% capture footer_content %}
{% if block.settings.menu.links.size > 0 %}<ul role="list">{% for item in block.settings.menu.links %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{% endfor %}</ul>
{% elsif block.settings.text != blank %}{{ block.settings.text }}
{% else %}{% assign footer_heading = block.settings.heading | downcase %}<ul role="list">{% case footer_heading %}
{% when 'shop' %}<li><a href="{{ storefront_root }}pages/explore">Explore</a></li><li><a href="{{ routes.all_products_collection_url }}">Shop all pieces</a></li><li><a href="{{ routes.collections_url }}">Collections</a></li><li><a href="{{ routes.search_url }}">Search</a></li>
{% when 'customer care' %}<li><a href="{{ storefront_root }}pages/faq">FAQ & customer care</a></li>{% if shop.shipping_policy.url %}<li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>{% endif %}{% if shop.refund_policy.url %}<li><a href="{{ shop.refund_policy.url }}">Returns</a></li>{% endif %}{% if shop.email %}<li><a href="mailto:{{ shop.email }}">Contact us</a></li>{% endif %}
{% when 'about' %}{% if shop.privacy_policy.url %}<li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>{% endif %}{% if shop.terms_of_service.url %}<li><a href="{{ shop.terms_of_service.url }}">Terms of service</a></li>{% endif %}
{% when 'connect' %}{% if shop.email %}<li><a href="mailto:{{ shop.email }}">Email</a></li>{% endif %}
{% endcase %}</ul>{% endif %}
{% endcapture %}{% assign footer_plain = footer_content | strip_html | strip %}{% if footer_plain != blank %}<div {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2>{{ footer_content }}</div>{% elsif request.design_mode %}<div class="editor-note" {{ block.shopify_attributes }}>Add a menu or text for {{ block.settings.heading }}.</div>{% endif %}
{% endfor %}</div></div><div class="footer-bottom"><a href="{{ routes.root_url }}" class="wordmark">{% render 'brand-wordmark' %}</a><a class="footer-faq" href="{{ storefront_root }}pages/faq">FAQ & customer care</a><small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.</small><div class="payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}{% form 'localization', class: 'localization-form' %}{% if localization.available_countries.size > 1 %}<label class="visually-hidden" for="Country">Country and currency</label><select id="Country" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select>{% endif %}{% if localization.available_languages.size > 1 %}<label class="visually-hidden" for="Language">Language</label><select id="Language" name="language_code">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}</select>{% endif %}<button type="submit">Update</button>{% endform %}{% endif %}</div></footer>

{% schema %}

{

  "name": "Footer",

  "settings": [],

  "blocks": [

    {

      "type": "column",

      "name": "Footer column",

      "settings": [

        {

          "type": "text",

          "id": "heading",

          "label": "Heading",

          "default": "Customer care"

        },

        {

          "type": "link_list",

          "id": "menu",

          "label": "Menu"

        },

        {

          "type": "richtext",

          "id": "text",

          "label": "Text"

        }

      ]

    }

  ]

}

{% endschema %}
