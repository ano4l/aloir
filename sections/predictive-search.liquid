{% if predictive_search.performed %}<div data-predictive-content><p id="PredictiveSummary" class="small-text">{% if predictive_search.resources.products.size > 0 %}Suggested pieces{% else %}No suggested pieces. Press Search to see all results.{% endif %}</p><ul role="list">{% for product in predictive_search.resources.products limit: 5 %}<li><a href="{{ product.url }}">{% render 'responsive-image', image: product.featured_image, sizes: '52px' %}<span>{{ product.title }}<small>{{ product.price | money }}</small></span></a></li>{% endfor %}</ul></div>{% endif %}
{% schema %}{"name":"Predictive search","settings":[]}{% endschema %}
