<section class="section category-section" data-category-section><div class="category-heading"><div><p class="eyebrow">Ways to wear Eloir</p><h2 id="CategoryHeading-{{ section.id }}" class="section-title">{{ section.settings.heading }}</h2></div><div class="rail-controls" hidden><button type="button" data-rail-prev aria-label="Previous wardrobe edit">{% render 'icon', name: 'arrow' %}</button><button type="button" data-rail-next aria-label="Next wardrobe edit">{% render 'icon', name: 'arrow' %}</button></div></div><div class="category-grid" data-category-rail role="group" aria-labelledby="CategoryHeading-{{ section.id }}" tabindex="0">{% for block in section.blocks %}<a class="category-tile" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% assign image_index = forloop.index0 | modulo: 3 | plus: 1 %}{% if image_index == 1 %}{% assign image_index = 2 %}{% elsif image_index == 2 %}{% assign image_index = 1 %}{% endif %}{% assign category_fallback = 'hero-' | append: image_index | append: '.webp' %}{% render 'responsive-image', image: block.settings.image, fallback: category_fallback, alt: block.settings.title %}<div class="category-caption"><span class="category-number" aria-hidden="true">0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3></div><p>{{ block.settings.description | escape }}</p><span>Explore {% render 'icon', name: 'arrow' %}</span></a>{% endfor %}</div></section>

{% schema %}

{

  "name": "Shop by category",

  "settings": [

    {

      "type": "text",

      "id": "heading",

      "label": "Heading",

      "default": "The wardrobe edits"

    }

  ],

  "blocks": [

    {

      "type": "category",

      "name": "Category",

      "settings": [

        {"type":"text","id":"description","label":"Editorial description","default":"A different way to make it your own."},

        {

          "type": "image_picker",

          "id": "image",

          "label": "Image"

        },

        {

          "type": "text",

          "id": "title",

          "label": "Title",

          "default": "Everyday essentials"

        },

        {

          "type": "collection",

          "id": "collection",

          "label": "Collection"

        }

      ]

    }

  ],

  "presets": [

    {

      "name": "Shop by category"

    }

  ]

}

{% endschema %}
