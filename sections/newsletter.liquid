<section class="newsletter section"><p class="eyebrow">A letter from Eloir</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div>{% assign newsletter_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: newsletter_id %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="Email-{{ section.id }}">Email address</label><div class="input-row"><input id="Email-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" placeholder="Your email address" required {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}><button type="submit" class="button">{{ section.settings.label }}</button></div>{% if form.posted_successfully? %}<p role="status">Thank you. You're part of our world.</p>{% endif %}{% if form.errors %}<div id="NewsletterError-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}<p class="privacy-note">{{ section.settings.privacy }}</p></section>

{% schema %}

{

  "name": "Newsletter",

  "settings": [

    {

      "type": "text",

      "id": "heading",

      "label": "Heading",

      "default": "Join our world"

    },

    {

      "type": "richtext",

      "id": "text",

      "label": "Description",

      "default": "<p>Discover new collections, exclusive edits, and considered pieces for every season.</p>"

    },

    {

      "type": "text",

      "id": "label",

      "label": "Button label",

      "default": "Subscribe"

    },

    {

      "type": "inline_richtext",

      "id": "privacy",

      "label": "Privacy note",

      "default": "By subscribing, you agree to receive marketing emails. Unsubscribe at any time."

    }

  ],

  "presets": [

    {

      "name": "Newsletter"

    }

  ]

}

{% endschema %}

