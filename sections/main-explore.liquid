{% assign storefront_root = routes.root_url | append: '/' | replace: '//', '/' %}
<section class="section explore-page" aria-labelledby="ExploreHeading-{{ section.id }}">
  <div class="explore-intro"><div><p class="eyebrow">Find your point of view</p><h1 id="ExploreHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1></div><div><p>{{ section.settings.introduction | escape }}</p><a class="text-link" href="{{ routes.collections_url }}">View all categories {% render 'icon', name: 'arrow' %}</a></div></div>
  <div class="explore-category-heading"><h2>Start with a collection</h2><span class="small-text">Considered pieces. Endless possibilities.</span></div>
  <div class="directory-grid explore-grid">{% assign explore_keys = 'tops_collection,dresses_collection,denim_collection,knitwear_collection' | split: ',' %}{% assign explore_handles = 'tops,dresses,denim,sweaters-knitwear' | split: ',' %}{% for key in explore_keys %}{% assign category = section.settings[key] %}{% if category == blank %}{% assign fallback_handle = explore_handles[forloop.index0] %}{% assign category = collections[fallback_handle] %}{% endif %}{% if category != blank and category.products_count > 0 %}{% render 'collection-directory-card', category: category, index: forloop.index %}{% endif %}{% endfor %}</div>
  <div class="explore-note"><p class="eyebrow">A different way to discover</p><h2>Follow a feeling.</h2><p>Light layers for days in motion. A textured knit. A dress that changes the mood.</p><a class="text-link" href="{{ storefront_root }}#SeasonalEdits">Explore the seasonal edits {% render 'icon', name: 'arrow' %}</a></div>
  {% assign explore_featured = section.settings.collection | default: collections.features %}{% if explore_featured.products_count > 0 %}<div class="collection-heading"><div><p class="eyebrow">The featured selection</p><h2>A few places to begin.</h2></div><a class="text-link" href="{{ explore_featured.url }}">All featured pieces {% render 'icon', name: 'arrow' %}</a></div><div class="product-grid discovery-product-grid">{% for product in explore_featured.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}
</section>
{% schema %}
{"name":"Explore collections","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"A wardrobe.\nYour own way."},{"type":"text","id":"introduction","label":"Introduction","default":"There is more than one way to get dressed. Discover the shapes, textures and everyday pieces that feel most like you."},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"collection","id":"tops_collection","label":"Tops"},{"type":"collection","id":"dresses_collection","label":"Dresses"},{"type":"collection","id":"denim_collection","label":"Denim"},{"type":"collection","id":"knitwear_collection","label":"Knitwear"}]}
{% endschema %}
